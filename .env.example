# ===== MODELO (sem valores reais). Copie para .env.local e preencha =====
# NUNCA coloque valores reais neste arquivo: ele vai para o GitHub.

# --- Site (Next.js / Vercel) ---  vai em .env.local e em Vercel > Settings > Environment Variables
NEXT_PUBLIC_SITE_URL=https://muitasconversas.vercel.app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Mercado Pago (NÃO usados pelo site) ---
# Estes valores vão SOMENTE em Supabase > Edge Functions > Secrets
# (ou: supabase secrets set --env-file supabase/.env.secrets).
# Não coloque no Vercel nem em variável NEXT_PUBLIC_*.
# MERCADOPAGO_ACCESS_TOKEN=      (Credenciais de produção, APP_USR-..., sem aspas e sem "Bearer")
# MERCADOPAGO_WEBHOOK_SECRET=    (Assinatura secreta do painel de Webhooks)
